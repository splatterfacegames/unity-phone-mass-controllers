<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QrDump</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- globs below are explicit; the default **/*.cs would double-include local files -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compiles the real Core QR sources, same as tests/dotnet and Unity. -->
    <Compile Include="..\..\Packages\com.splatterfacegames.phone-mass-controllers\Runtime\Core\Qr\**\*.cs" />
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>
</Project>
